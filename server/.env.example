# Get these at https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=your_client_id
PLAID_SECRET=your_sandbox_secret
# sandbox | production
PLAID_ENV=sandbox

# 32-byte key used to encrypt Plaid access tokens at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Optional: public URL Plaid can reach (e.g. an ngrok tunnel) + /api/webhook
PLAID_WEBHOOK_URL=

PORT=8000
DB_PATH=finance.db
